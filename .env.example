# ─── PrivatePrompt environment ──────────────────────────────────────────────
# Copy to `.env` and fill in the values you have. Missing values are safe:
# the Midnight adapter will drop into its `local_fallback` mode and the UI
# will surface that state in the top bar.

# Midnight network identifier. Examples: "testnet", "devnet", "mainnet".
VITE_MIDNIGHT_NETWORK=testnet

# Deployed contract address for `privacy_audit.compact`. Leave blank to keep
# the generated client in stub mode (local_fallback in the UI).
VITE_CONTRACT_ADDRESS=

# Set to "false" to disable Midnight integration entirely (useful for
# offline demos). Defaults to enabled.
VITE_MIDNIGHT_ENABLED=true
